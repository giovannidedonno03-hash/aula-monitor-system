# Copiare questo file in ".env" sul server e compilarlo (il file .env NON va su GitHub).

# Indirizzo del sito, senza https:// (es. l'alias che Webdock da' al server)
DOMINIO=nomeserver.vps.webdock.cloud

# Password del database: lunga, solo lettere e numeri (niente @ : / #)
POSTGRES_PASSWORD=cambiami

# Chiave per firmare i login. Generarla sul server con:  openssl rand -hex 32
SECRET_KEY=cambiami

# Client ID di Google (lo stesso di docker-compose.yml)
GOOGLE_CLIENT_ID=284742808943-vu5gadhoreke8mkp44ucb0cm5b53vcqh.apps.googleusercontent.com

# Solo le email della scuola possono accedere (vuoto = qualsiasi account Google)
ALLOWED_EMAIL_DOMAIN=itisgrassi.edu.it
